{
  "name": "copy-syntax-in-light",
  "displayName": "Copy Syntax In Light Theme",
  "publisher": "AhmedAdel",
  "icon": "images/logo.png",
  "description": "Smoothly copy code syntax in light mode or using current theme syntax, seamlessly returning to your preferred theme in VS Code.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copy-syntax-in-light.copySyntaxInLight",
        "title": "Copy Syntax In Light Theme"
      },
      {
        "command": "copy-syntax-in-light.selectTheme",
        "title": "Copy Syntax In Light: Select Custom Theme"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "copy-syntax-in-light.copySyntaxInLight",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copy-syntax-in-light.copySyntaxInLight",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Copy Syntax In Light",
      "properties": {
        "copySyntaxInLight.customTheme": {
          "type": "string",
          "default": "current",
          "description": "The color theme to use when copying syntax. Set to 'current' (default) to copy with current theme syntax without changing VS Code theme, or specify an installed theme name."
        },
        "copySyntaxInLight.removeBackground": {
          "type": "boolean",
          "default": true,
          "description": "Remove background color from copied syntax highlighting HTML so only text highlights are copied."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahmed-Adel-Morsi/Copy-Syntax-in-Light"
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.86.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9"
  }
}
